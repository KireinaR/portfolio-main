# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (a MongoDB Atlas cluster works fine on Vercel).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js - random secret used to sign session JWTs / cookies.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers -> New OAuth App)
# Homepage URL:            https://your-domain.com
# Authorization callback:  https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Password + signing secret for the /verify moderation page (independent of GitHub/Google login).
ADMIN_PASSWORD=
ADMIN_SECRET=

# Resend (resend.com) - used by the /contact form's /api/contact route to send email.
# Server-side only, never exposed to the client.
RESEND_API_KEY=
# Inbox that contact-form submissions get delivered to.
CONTACT_TO_EMAIL=
# Sender address Resend sends as. Must be on a domain verified in Resend
# (resend.com/domains) - the sandbox onboarding@resend.dev only works for
# sending to the Resend account's own signup address.
CONTACT_FROM_EMAIL=
# Sender name/address for the courtesy reply sent back to the visitor.
CONTACT_CONFIRM_FROM_EMAIL=
